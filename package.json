{
  "name": "cloudflare-demo",
  "description": "Cloudflare Workers + SvelteKit monorepo",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:workflow": "pnpm --filter @cloudflare-demo/analyse-workflow dev",
    "dev:backend": "pnpm --filter @cloudflare-demo/backend dev",
    "dev:frontend": "pnpm --filter @cloudflare-demo/frontend dev",
    "vite": "pnpm --filter @cloudflare-demo/frontend run vite",
    "bootstrap:access": "pnpm --filter @cloudflare-demo/infrastructure run bootstrap:access",
    "bootstrap:api-key": "pnpm --filter @cloudflare-demo/infrastructure run bootstrap:api-key",
    "bootstrap:database": "pnpm --filter @cloudflare-demo/infrastructure run bootstrap:database",
    "bootstrap:r2": "pnpm --filter @cloudflare-demo/infrastructure run bootstrap:r2",
    "bootstrap": "pnpm run bootstrap:access && pnpm run bootstrap:api-key && pnpm run bootstrap:database && pnpm run bootstrap:r2",
    "db:apply": "pnpm --filter @cloudflare-demo/backend exec wrangler d1 migrations apply demo-db --remote",
    "db:apply:local": "pnpm --filter @cloudflare-demo/backend exec wrangler d1 migrations apply demo-db --local",
    "build": "pnpm -r build",
    "deploy:frontend": "pnpm --filter @cloudflare-demo/frontend run deploy",
    "deploy:backend": "pnpm --filter @cloudflare-demo/backend run deploy",
    "deploy:all": "pnpm run deploy:backend && pnpm run deploy:frontend",
    "preview": "pnpm --filter @cloudflare-demo/frontend preview",
    "check": "pnpm --filter @cloudflare-demo/frontend check",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "biome check .",
    "audit": "pnpm audit",
    "format": "biome format --write .",
    "quality": "pnpm lint && pnpm test:coverage && pnpm audit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@lucide/svelte": "^1.25.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "runed": "^0.37.1",
    "svelte-toolbelt": "^0.10.6",
    "tailwind-merge": "^3.6.0"
  }
}
